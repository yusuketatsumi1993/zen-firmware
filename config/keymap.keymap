/* Coron LP source confirmed: 2026-09-08 build94.
 * ZEN port: private text macros remain inactive placeholders.
 * Ordinary keymap compiled locally; no flash performed.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };
        private_slot_01: private_slot_01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
        };
        private_slot_02: private_slot_02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
        };
        private_slot_03: private_slot_03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
        };
        private_slot_04: private_slot_04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
        };
        private_slot_05: private_slot_05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
        };
        private_slot_06: private_slot_06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";
        eq {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <9 10>;
            timeout-ms = <150>;
                };
        kakko {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <21 22>;
            timeout-ms = <150>;
                };
        left {
            bindings = <&mkp LCLK>;
            key-positions = <19 20>;
            timeout-ms = <150>;
                };
        right {
            bindings = <&mkp RCLK>;
            key-positions = <20 21>;
            timeout-ms = <150>;
                };
        middle {
            bindings = <&mkp MB3>;
            key-positions = <19 21>;
            timeout-ms = <150>;
                };
        prev {
            bindings = <&mkp MB4>;
            key-positions = <7 8>;
            timeout-ms = <150>;
            layers = <1 2 3 4 5>;
                };
        next {
            bindings = <&mkp MB5>;
            key-positions = <8 9>;
            timeout-ms = <150>;
            layers = <1 2 3 4 5>;
                };
        midd {
            bindings = <&mkp MCLK>;
            key-positions = <2 4>;
            timeout-ms = <150>;
                };
        private_combo_01 {
            bindings = <&private_slot_01>;
            key-positions = <1 0>;
                };
        private_combo_02 {
            bindings = <&private_slot_02>;
            key-positions = <13 12>;
                };
        private_combo_03 {
            bindings = <&private_slot_04>;
            key-positions = <25 24>;
                };
        private_combo_04 {
            bindings = <&private_slot_05>;
            key-positions = <10 11>;
                };
        private_combo_05 {
            bindings = <&private_slot_06>;
            key-positions = <22 23>;
                };
        relocated_cmd_right {
            bindings = <&kp LG(RIGHT)>;
            key-positions = <16 17>;
            layers = <2>;
            timeout-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
            &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BACKSPACE
            &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &lt 5 K  &kp L  &kp SLASH  &kp ENTER
            &kp LEFT_SHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &lt_to_layer_0 3 LS(EXCLAMATION)  &mt LEFT_SHIFT BACKSPACE  &kp N  &kp M  &mt RIGHT_GUI COMMA  &kp DOT  &kp MINUS  &kp EQUAL
            &kp LEFT_ALT  &kp LG(LS(N5))  &mt LEFT_WIN RIGHT_SHIFT  &mt LEFT_ALT TAB  &lt_to_layer_0 1 TAB  &mt LEFT_SHIFT SPACE  &mt LEFT_COMMAND LANGUAGE_2  &mt LANG_HANGEUL BACKSPACE  &lt_to_layer_0 2 ENTER  &mt LG(LS(N5)) COLON  &kp LC(UP_ARROW)  &kp LG(LA(ESC))
            >;
        };

        layer_1 {
            bindings = <
            &kp ESCAPE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
            &trans  &kp C_MUTE  &kp C_VOLUME_UP  &msc SCRL_UP  &trans  &kp C_BRI_UP  &trans  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &trans  &trans
            &trans  &trans  &kp C_VOLUME_DOWN  &msc SCRL_DOWN  &kp LANGUAGE_1  &kp C_BRI_DN  &trans  &trans  &kp N0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
            &trans  &trans  &trans  &kp F3  &kp F4  &kp F5  &kp EXCLAMATION  &kp MINUS  &kp UP_ARROW  &kp LS(SLASH)  &kp TILDE  &kp AT_SIGN
            &trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_UP  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &kp LS(NUMBER_1)  &kp COLON
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_DOWN  &private_slot_01  &kp EQUAL  &trans  &trans  &kp UNDER
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
            &trans  &trans  &mkp MB1  &kp UP_ARROW  &mkp MB2  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &bt BT_PRV  &trans  &bt BT_NXT  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR  &bt BT_CLR_ALL
            >;
        };

        layer_4 {
            bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RIGHT_CONTROL  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
